    { "id": "loaders", "name": "加载状态" }
  ],
  "useCases": [
    { "id": "hero", "name": "首屏背景" },
    { "id": "button", "name": "按钮反馈" },
    { "id": "transition", "name": "页面切换" },
    { "id": "loading", "name": "加载状态" },
    { "id": "reveal", "name": "内容呈现" }
  ],
  "effects": [
    {
      "id": "particle-form",
      "name": "粒子聚形",
      "description": "浅灰颗粒铺满画布，深色点云在右侧绕成一条回环。移动鼠标可以推散附近的颗粒，移开后颗粒慢慢归位。",
      "category": "particles",
      "useCases": ["hero", "reveal"],
      "tags": ["鼠标交互", "背景", "聚形", "回环", "点云", "particle field", "cursor repulsion"],
      "technology": "Canvas 2D",
      "dependencies": [],
      "addedAt": "2026-11-18",
      "demo": "./?effect=particle-form",
      "thumbnail": "./effects/particle-form/preview.png",
      "source": "./effects/particle-form/index.js",
      "docs": "./effects/particle-form/README.md",
      "mountExport": "mountParticleForm",
      "parameters": {
        "mode": {
          "label": "构图",
          "type": "enum",
          "values": ["form", "field"],
          "default": "form",
          "description": "form 聚成轮廓，field 均匀散布。"
        },
        "density": {
          "label": "粒子密度",
          "type": "number",
          "default": 0.7,
          "min": 0.15,
          "max": 1,
          "step": 0.05,
          "unit": "ratio",
          "description": "当前画布尺寸下的粒子数量比例。"
        },
        "speed": {
          "label": "漂移速度",
          "type": "number",
          "default": 1,
          "min": 0.2,
          "max": 2,
          "step": 0.1,
          "unit": "multiplier",
          "description": "粒子漂移的时间倍率。"
        },
        "pointerRadius": {
          "label": "鼠标影响范围",
          "type": "number",
          "default": 95,
          "min": 30,
          "max": 180,
          "step": 5,
          "unit": "px",
          "description": "粒子被指针推开的半径，以 CSS 像素计。"
        }
      },
      "presets": [
        { "id": "form", "name": "聚形", "options": { "mode": "form", "density": 0.7, "speed": 1, "pointerRadius": 95 } },
        { "id": "field", "name": "散场", "options": { "mode": "field", "density": 0.5, "speed": 0.6, "pointerRadius": 75 } }
      ]
    },
    {
      "id": "particle-nebula",
      "name": "星云旋转",
      "description": "浅底上的石墨色星尘沿螺旋臂绕中心旋转，内圈转得比外圈快。",
      "category": "particles",
      "useCases": ["hero", "reveal"],
      "tags": ["星云", "旋转", "螺旋", "星尘", "nebula", "galaxy", "rotation"],
      "technology": "Canvas 2D",
      "dependencies": ["./effects/canvas-motion.js"],
      "addedAt": "2026-11-18",
      "demo": "./?effect=particle-nebula",
      "thumbnail": "./effects/particle-nebula/preview.png",
      "source": "./effects/particle-nebula/index.js",
      "docs": "./effects/particle-nebula/README.md",
      "mountExport": "mountParticleNebula",
      "parameters": {
        "density": { "label": "星尘密度", "type": "number", "default": 0.8, "min": 0.25, "max": 1, "step": 0.05, "unit": "ratio", "description": "螺旋臂星尘的数量比例。" },
        "speed": { "label": "旋转速度", "type": "number", "default": 1, "min": 0.2, "max": 2, "step": 0.1, "unit": "multiplier", "description": "旋转的时间倍率。" },
        "arms": { "label": "旋臂数", "type": "number", "default": 3, "min": 2, "max": 5, "step": 1, "description": "围绕中心展开的螺旋臂数量。" }
      },
      "presets": [
        { "id": "violet", "name": "三旋星云", "options": { "density": 0.8, "speed": 1, "arms": 3 } },
        { "id": "ice", "name": "双旋星云", "options": { "density": 0.7, "speed": 0.7, "arms": 2 } }
      ]
    },
    {
      "id": "particle-waterfall",
      "name": "粒子瀑布",
      "description": "石墨色粒子从画布顶部持续下滑，从底部离开画面。",
      "category": "particles",
      "useCases": ["hero", "reveal"],
      "tags": ["瀑布", "流动", "水流", "下落", "waterfall", "flow"],
      "technology": "Canvas 2D",
      "dependencies": ["./effects/canvas-motion.js"],
      "addedAt": "2026-11-18",
      "demo": "./?effect=particle-waterfall",
      "thumbnail": "./effects/particle-waterfall/preview.png",
      "source": "./effects/particle-waterfall/index.js",
      "docs": "./effects/particle-waterfall/README.md",
      "mountExport": "mountParticleWaterfall",
      "parameters": {
        "density": { "label": "水线密度", "type": "number", "default": 0.8, "min": 0.25, "max": 1, "step": 0.05, "unit": "ratio", "description": "垂落水线的数量比例。" },
        "speed": { "label": "流动速度", "type": "number", "default": 1, "min": 0.2, "max": 2, "step": 0.1, "unit": "multiplier", "description": "粒子下滑的时间倍率。" },
        "width": { "label": "瀑布宽度", "type": "number", "default": 0.35, "min": 0.15, "max": 0.65, "step": 0.05, "unit": "ratio", "description": "水流的横向扩展比例，以画布宽度为基准。" }
      },
      "presets": [
        { "id": "cascade", "name": "峡谷细瀑", "options": { "density": 0.8, "speed": 1, "width": 0.35 } },
        { "id": "veil", "name": "宽幅水帘", "options": { "density": 0.95, "speed": 1.3, "width": 0.55 } }
      ]
    },
    {
      "id": "theme-ripple",
      "name": "日夜主题涟漪",
      "description": "点击右上角的主题按钮，旧主题向按钮中心收拢，露出下方的新主题。",
      "category": "transitions",
      "useCases": ["button", "transition"],
      "tags": ["日间", "夜间", "深色模式", "主题切换", "涟漪", "theme", "ripple", "clip-path"],
      "technology": "CSS · Web Animations",
      "dependencies": [],
      "addedAt": "2026-11-19",
      "demo": "./?effect=theme-ripple",
      "thumbnail": "./effects/theme-ripple/preview.png",
      "source": "./effects/theme-ripple/index.js",
      "docs": "./effects/theme-ripple/README.md",
      "mountExport": "mountThemeRipple",
      "previewType": "html",
      "parameters": {
        "duration": { "label": "收拢时长", "type": "number", "default": 560, "min": 200, "max": 1000, "step": 20, "unit": "ms", "description": "旧主题涟漪收进按钮的总时长。" }
      },
      "presets": [
        { "id": "standard", "name": "标准收拢", "options": { "duration": 560 } },
        { "id": "slow", "name": "慢速收拢", "options": { "duration": 900 } }
      ]
    },
    {
      "id": "damped-card",
      "name": "阻尼卡片",
      "description": "卡片跟随指针做 3D 倾斜，反光随位置移动。移开鼠标或松手后，弹簧带着轻微过冲回正。",
      "category": "feedback",
      "useCases": ["reveal"],
      "tags": ["工作区", "卡片", "鼠标交互", "阻尼", "弹簧", "流光", "damping", "spring", "tilt"],
      "technology": "CSS 3D · JavaScript",
      "dependencies": [],
      "addedAt": "2026-11-19",
      "demo": "./?effect=damped-card",
      "thumbnail": "./effects/damped-card/preview.png",
      "source": "./effects/damped-card/index.js",
      "docs": "./effects/damped-card/README.md",
      "mountExport": "mountDampedCard",
      "previewType": "html",
      "parameters": {
        "angle": { "label": "最大倾角", "type": "number", "default": 8, "min": 2, "max": 12, "step": 1, "unit": "°", "description": "卡片边缘的目标倾斜角度。" },
        "damping": { "label": "弹簧阻尼", "type": "number", "default": 15, "min": 10, "max": 26, "step": 1, "description": "数值越高，回正时的过冲越小。" }
      },
      "presets": [
        { "id": "workspace", "name": "工作区手感", "options": { "angle": 8, "damping": 15 } },
        { "id": "steady", "name": "稳重回正", "options": { "angle": 5, "damping": 23 } }
      ]
    },
    {
      "id": "timed-reveal",
      "name": "限时揭幕",
      "description": "在区域内移动鼠标，纯色幕布围绕标题圆形收拢，照片从右上向左下滑动。鼠标停下后倒计时，移出则立即开始盖回。",
      "category": "transitions",
      "useCases": ["reveal"],
      "tags": ["预览", "悬停", "遮罩", "图片", "限时", "hover", "reveal", "mosaic"],
      "technology": "CSS · Web Animations",
      "dependencies": ["./effects/timed-reveal/light-and-materials.webp"],
      "addedAt": "2026-11-20",
      "demo": "./?effect=timed-reveal",
      "thumbnail": "./effects/timed-reveal/preview.png",
      "source": "./effects/timed-reveal/index.js",
      "docs": "./effects/timed-reveal/README.md",
      "mountExport": "mountTimedReveal",
      "previewType": "html",
      "parameters": {
        "duration": { "label": "收拢时长", "type": "number", "default": 420, "min": 150, "max": 1000, "step": 10, "unit": "ms", "description": "色块收拢和盖回各自用时。" },
        "speed": { "label": "图片漂移速度", "type": "number", "default": 52, "min": 12, "max": 120, "step": 1, "unit": "px/s", "description": "图片沿横向和纵向每秒各自移动的像素数。" },
        "hold": { "label": "停驻时长", "type": "number", "default": 2500, "min": 600, "max": 6000, "step": 100, "unit": "ms", "description": "收拢后从最后一次移动到开始盖回的等待时长。" }
      },
      "presets": [
        { "id": "standard", "name": "标准揭幕", "options": { "duration": 420, "speed": 52, "hold": 2500 } },
        { "id": "slow", "name": "从容浏览", "options": { "duration": 600, "speed": 30, "hold": 4200 } }
      ]
    }
  ]
}
